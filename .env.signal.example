###############################################################################
# Signal-driven PAPER bot — example environment for a NEW Coolify app / instance
#
# This bot never creates a CLOB client and never posts an order.  Do NOT put
# API keys or a private key here: they are not needed and would only make the
# paper/live boundary less obvious.
#
# Start command (Coolify / Docker):
#   BOT_MODE=signal python -m src.main
# or:
#   python -m src.signal_main
###############################################################################

BOT_MODE=signal
PAPER_TRADING=true

WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8020
WEB_USERNAME=admin
# Set this in the Coolify panel, not in a committed file.
# WEB_PASSWORD=change-me

# ── Signal-driven paper strategy (all editable at /config → 信号交易) ────
SIGNAL_TRADE_ENABLED=true
SIGNAL_TRADE_STAKE_USD=2.0
SIGNAL_TRADE_PRICE_MIN=0.75
SIGNAL_TRADE_PRICE_MAX=0.90
SIGNAL_TRADE_M5_MIN_CONFIRM=0.20
SIGNAL_TRADE_REQUIRE_M5=true
SIGNAL_TRADE_TP_PCT=0.10
SIGNAL_TRADE_SL_PCT=0.15
SIGNAL_TRADE_TIME_EXIT_S=60
SIGNAL_TRADE_ENTRY_START_S=60
SIGNAL_TRADE_ENTRY_END_BEFORE_END_S=180
SIGNAL_TRADE_MAX_ENTRIES=1
SIGNAL_TRADE_ALLOW_REENTRY=false
SIGNAL_TRADE_ENTRY_MAKER=true
SIGNAL_TRADE_EXIT_MAKER=true
SIGNAL_TRADE_MAKER_OFFSET=0.005
SIGNAL_TRADE_ENTRY_TIMEOUT_S=5
SIGNAL_TRADE_MAX_ATTEMPTS=3
SIGNAL_TRADE_MAX_SPREAD=0.03
SIGNAL_TRADE_MIN_IMBALANCE=-0.60
SIGNAL_TRADE_MAX_SELL_FLOW=0.60
SIGNAL_TRADE_MAX_TREND_AGAINST=0.70
SIGNAL_TRADE_MAX_SIGMA_PCT=0.25
# -1 = ignore the digital edge. The 6-month study found it anti-predictive;
# set a value only when deliberately re-testing it as a filter.
SIGNAL_TRADE_MIN_EDGE=-1.0
SIGNAL_TRADE_USE_SIGNAL_GATES=true
SIGNAL_TRADE_IGNORE_REASONS=edge,strike_z,5m_against
SIGNAL_TRADE_EXIT_ON_FLIP=false
SIGNAL_TRADE_FLIP_CONFIRM=0.0

# Forward-research snapshots (2s cadence by default). The default path is
# <data dir>/signal_snapshots.jsonl = /app/data/signal_snapshots.jsonl.
SIGNAL_TRADE_SNAPSHOT_S=2.0
# SIGNAL_TRADE_SNAPSHOT_PATH=/app/data/signal_snapshots.jsonl

# The rest of the signal thresholds (spread / CVD / macro / event / 5m) are
# inherited from .env.docker; override only if needed.
# SIGNAL_GATES_ENABLED=true
# SIGNAL_MICRO_GATE_ENABLED=true
# SIGNAL_MACRO_GATE_ENABLED=true
# SIGNAL_EVENT_GATE_ENABLED=true
